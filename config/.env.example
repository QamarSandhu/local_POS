# ==============================================================
# Let's Buy It - Self-Hosted Business Installation Configuration
# ==============================================================

NODE_ENV=production
DEPLOYMENT_MODE=self-hosted
PORT=3001
WEB_PORT=3000

# Base Public URLs
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Local PostgreSQL Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=letsbuyit_business
DB_USER=letsbuyit_app
DB_PASSWORD=CHANGEME_SECURE_PASSWORD
DB_SSL=false
DB_POOL_MAX=20

# JWT Secrets (Generated automatically by install script)
JWT_ACCESS_SECRET=CHANGEME_SECURE_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGEME_SECURE_JWT_REFRESH_SECRET
JWT_ACCESS_EXPIRATION=30d
JWT_REFRESH_EXPIRATION=90d

# Local File Storage Driver
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage/uploads

# Cryptographic License Verification (Public verification key only)
LICENSE_PUBLIC_KEY=MCowBQYDK2VwAyEAPjb2nTgSU0g8/mouPBSpxNpyCBy1u1sw2hnM90KebnM=
